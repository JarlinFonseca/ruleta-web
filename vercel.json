{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api-ruleta/:path*",
      "destination": "http://ruleta-api-alb-1172962453.us-east-1.elb.amazonaws.com/api-ruleta/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
