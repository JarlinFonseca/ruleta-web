# Base de la API. Por defecto el mismo origen (proxy de Vite en desarrollo, CloudFront en producción).
VITE_API_BASE_URL=/api-ruleta/v1
# true = usa el backend simulado en memoria (MSW) en el navegador. Solo desarrollo.
VITE_ENABLE_MSW=false
# Ruleta WebGL (HU-30, después del MVP). Hoy solo existe el punto de extensión.
VITE_ENABLE_WHEEL_3D=false
# R2: campo de correo del participante (HU-23). Oculto en el MVP.
VITE_ENABLE_PARTICIPANT_EMAIL=false
# URL opcional para enviar errores del navegador (P-F1). Vacío = solo consola.
VITE_ERROR_REPORTING_URL=
# Solo para el proxy de Vite (no se expone al navegador).
API_PROXY_TARGET=http://localhost:8080
